{
  "expo": {
    "name": "Escaner de Huevos",
    "slug": "escaner-huevos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Se usa la cámara para escanear y clasificar huevos."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Se usa la cámara para escanear y clasificar huevos."
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
