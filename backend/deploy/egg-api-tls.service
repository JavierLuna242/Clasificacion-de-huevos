[Unit]
Description=API clasificador de huevos (YOLO11) - HTTPS para la web/camara
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/egg-api
ExecStart=/home/ubuntu/egg-api/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443 --ssl-keyfile certs/key.pem --ssl-certfile certs/cert.pem
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
